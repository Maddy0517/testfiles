<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Console appender for local development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- File appender for detailed logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/workday-pipeline.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/workday-pipeline.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- Structured logging appender for Cloud Logging -->
    <appender name="CLOUD_LOGGING" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <loggerName/>
                <message/>
                <mdc/>
                <arguments/>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>
    
    <!-- Specific loggers -->
    <logger name="com.company.dataflow" level="INFO"/>
    <logger name="org.apache.beam" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>
    <logger name="com.google.cloud" level="WARN"/>
    <logger name="com.google.api" level="WARN"/>
    
    <!-- Workday API specific logging -->
    <logger name="com.company.dataflow.io.WorkdaySOAPClient" level="DEBUG"/>
    <logger name="com.company.dataflow.transform" level="INFO"/>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <!-- Uncomment for file logging in local environment -->
        <!-- <appender-ref ref="FILE"/> -->
        
        <!-- Use structured logging in cloud environment -->
        <!-- <appender-ref ref="CLOUD_LOGGING"/> -->
    </root>
    
</configuration>